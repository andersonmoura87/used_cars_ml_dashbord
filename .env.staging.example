# ─────────────────────────────────────────────────────────────────────────────
# .env.staging.example — variáveis para o ambiente de staging
#
# Copie para .env.staging e preencha TODOS os valores antes de usar:
#   cp .env.staging.example .env.staging
#
# No CI (GitHub Actions), configure como Secrets em:
#   Settings → Secrets and variables → Actions
#
# NUNCA commite .env.staging com valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# ── Imagem Docker ─────────────────────────────────────────────────────────────
# Imagem construída pelo CI (SHA da branch) ou imagem local para teste manual
DOCKER_IMAGE=ghcr.io/<org>/used-cars-ml:staging
# Exemplo local: DOCKER_IMAGE=used-cars-ml:latest

# ── Banco de dados ────────────────────────────────────────────────────────────
# Use uma senha diferente do banco de produção
# Gere com: openssl rand -hex 32
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Use uma senha diferente do Redis de produção
# Gere com: openssl rand -hex 32
REDIS_PASSWORD=

# ── API ───────────────────────────────────────────────────────────────────────
# Chave de autenticação para smoke tests no staging
# Deve ser diferente da chave de produção
# Gere com: openssl rand -hex 32
# No CI: secret STAGING_API_KEY
API_KEY=

# Origens CORS permitidas no staging
CORS_ORIGINS=http://localhost:8601

# ── MLflow ────────────────────────────────────────────────────────────────────
# URL do tracking server de staging
# Deixe em branco para desabilitar o tracking no staging
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=used_cars_price_model_staging
MLFLOW_REGISTERED_MODEL=used_cars_price_model

# ── UCM-22: Observabilidade ───────────────────────────────────────────────────
# Hash do commit — injetado automaticamente pelo CI via ${{ github.sha }}
# Em teste manual: git rev-parse --short HEAD
GIT_SHA=

# Endpoint do OTEL Collector para traces de staging (deixe vazio para desabilitar)
# Exemplo com Jaeger local: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Smoke Tests ───────────────────────────────────────────────────────────────
# URL base da API no ambiente de staging
API_BASE_URL=http://localhost:8100

# Timeout em segundos por requisição nos smoke tests
SMOKE_TIMEOUT=15

# Tempo máximo (segundos) para aguardar a API ficar disponível
SMOKE_WAIT_SECONDS=90
